// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role hierarchy: USER < MEMBER < ADMIN < SUPERADMIN
enum Role {
  USER
  MEMBER
  AUTHOR
  ADMIN
  SUPERADMIN
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @unique
  passwordHash     String?   @map("password_hash")  // Optional for OAuth users
  googleId         String?   @unique @map("google_id")  // Google OAuth ID
  realName         String?   @map("real_name")  // Actual name (editable)
  club             String?   // Club affiliation (editable)
  useRealName      Boolean   @default(false) @map("use_real_name") // Show real name in comments?
  role             Role      @default(USER)
  resetToken       String?   @map("reset_token")  // Password reset token
  resetTokenExpiry DateTime? @map("reset_token_expiry")  // Token expiration
  lastLogin        DateTime? @map("last_login")  // Last login timestamp
  createdAt        DateTime  @default(now()) @map("created_at")
  
  authoredNews    News[]   @relation("NewsAuthor")
  coAuthoredNews  News[]   @relation("NewsCoAuthor")
  puzzleResults             PuzzleRaceResult[]
  puzzleCampAttempts        PuzzleCampAttempt[]
  createdPuzzleCampSessions PuzzleCampSession[] @relation("PuzzleCampCreator")
  recordedGames   GameRecorded[]
  comments        Comment[]
  announcements   Announcement[]
  documents       Document[]
  travelReports   TravelReport[]
  forumTopics     ForumTopic[]
  forumPosts      ForumPost[]
  diagrams        Diagram[]
  fragments       Fragment[]
  
  @@map("users")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  newsId    Int      @map("news_id")
  authorId  Int      @map("author_id")
  parentId  Int?     @map("parent_id")
  isHidden  Boolean  @default(false) @map("is_hidden")
  isDeleted Boolean  @default(false) @map("is_deleted")
  deletedBy Int?     @map("deleted_by") // user ID who deleted it
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([newsId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model Message {
  id        Int      @id @default(autoincrement())
  author    String
  content   String
  type      String   @default("chat") // 'chat', 'wish'
  createdAt DateTime @default(now())
}

model News {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  category      String
  excerpt       String
  content       String?
  thumbnailUrl  String?   @map("thumbnail_url")
  linkUrl       String?   @map("link_url")
  gamesJson     String?   @map("games_json")
  teamsJson     String?   @map("teams_json")
  galleryJson   String?   @map("gallery_json")
  introJson     String?   @map("intro_json")
  publishedDate DateTime  @map("published_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  isPublished   Boolean   @default(false) @map("is_published")
  
  // Author - defaults to creator, can be overridden
  authorId      Int?      @map("author_id")
  authorName    String?   @map("author_name")  // Custom name if not from user
  
  // Co-author (optional)
  coAuthorId    Int?      @map("co_author_id")
  coAuthorName  String?   @map("co_author_name")  // Custom name if not from user
  
  author        User?     @relation("NewsAuthor", fields: [authorId], references: [id])
  coAuthor      User?     @relation("NewsCoAuthor", fields: [coAuthorId], references: [id])
  matchReport   MatchReport?
  games         Game[]
  comments      Comment[]
  
  // Stats
  viewCount     Int       @default(0) @map("view_count")

  // Facebook sharing
  facebookPostId    String?   @map("facebook_post_id")
  facebookSharedAt  DateTime? @map("facebook_shared_at")
  facebookMessage   String?   @map("facebook_message")

  // Instagram Stories sharing
  instagramStoryIds   String?   @map("instagram_story_ids")   // JSON array of IG media IDs
  instagramSharedAt   DateTime? @map("instagram_shared_at")

  images        Image[]

  @@index([isPublished, publishedDate])
  @@index([category])
  @@map("news")
}

model MatchReport {
  id          Int      @id @default(autoincrement())
  newsId      Int      @unique @map("news_id")
  matchDate   DateTime @map("match_date")
  teamAName   String   @map("team_a_name")
  teamBName   String   @map("team_b_name")
  scoreA      Int?     @map("score_a")
  scoreB      Int?     @map("score_b")
  reportText  String?  @map("report_text")
  createdAt   DateTime @default(now()) @map("created_at")
  
  news        News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  games       Game[]
  
  @@map("match_reports")
}

model Game {
  id            Int      @id @default(autoincrement())
  gameTitle     String   @map("game_title")
  chessComId    String   @map("chess_com_id")
  whitePlayer   String?  @map("white_player")
  blackPlayer   String?  @map("black_player")
  team          String?
  positionOrder Int?     @map("position_order")
  isCommented   Boolean  @default(false) @map("is_commented")
  
  // Flexible relations - game can belong to report OR news
  reportId      Int?     @map("report_id")
  newsId        Int?     @map("news_id")
  
  report        MatchReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  news          News?        @relation(fields: [newsId], references: [id], onDelete: Cascade)
  
  pgn           String?  @map("pgn")
  puzzleScannedAt DateTime? @map("puzzle_scanned_at")

  puzzleCandidates PuzzleCandidate[]

  @@map("games")
  @@index([chessComId])
}

model PuzzleCandidate {
  id           Int       @id @default(autoincrement())
  gameId       Int       @map("game_id")
  newsId       Int?      @map("news_id")
  fen          String
  bestMoveLan  String    @map("best_move_lan")
  bestSan      String    @map("best_san")
  toMove       String    @map("to_move")
  uniqMargin   Float     @map("uniq_margin")
  mateIn       Int?      @map("mate_in")
  bestCp       Int?      @map("best_cp")
  playedBest   Boolean   @default(false) @map("played_best")
  ply          Int
  moveNo       Int       @map("move_no")
  whitePlayer  String    @map("white_player")
  blackPlayer  String    @map("black_player")
  newsTitle    String?   @map("news_title")
  gameDate     DateTime? @map("game_date")
  score        Int
  difficulty   String
  motifs       String?
  forcingLen   Int?      @map("forcing_len")
  cpGap        Int?      @map("cp_gap")
  solutionLine String?   @map("solution_line")  // celá vynucená varianta (UCI, CSV)
  solutionSan  String?   @map("solution_san")   // varianta v SAN pro zobrazení
  rating       Int       @default(0)             // agregát hlasů (suma value)
  voteCount    Int       @default(0) @map("vote_count")
  dismissed    Boolean   @default(false)
  usedInNewsId Int?      @map("used_in_news_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  game         Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  votes        PuzzleVote[]

  @@unique([gameId, ply])
  @@index([score])
  @@map("puzzle_candidates")
}

model PuzzleVote {
  id          Int             @id @default(autoincrement())
  candidateId Int             @map("candidate_id")
  userId      Int?            @map("user_id")
  value       Int             // -1 špatná, 1 dobrá, 2 skvělá
  source      String          @default("admin") // admin / member / solver
  createdAt   DateTime        @default(now()) @map("created_at")

  candidate   PuzzleCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, userId])
  @@index([candidateId])
  @@map("puzzle_votes")
}

// Vyřešení Hádanky dne — základ pro streak 🔥 a "dnes vyřešili".
// Bez FK: kandidáti se dedupují/mažou, historie řešení má zůstat.
model PuzzleSolve {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  username    String?
  candidateId Int      @map("candidate_id")
  dateKey     String   @map("date_key")   // YYYY-MM-DD dne hádanky
  solvedAt    DateTime @default(now()) @map("solved_at")

  @@unique([userId, dateKey])
  @@index([dateKey])
  @@map("puzzle_solves")
}

model Image {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String?  @map("original_name")
  url          String
  altText      String?  @map("alt_text")
  category     String?  @map("category") // e.g. "blicak"
  newsId       Int?     @map("news_id")
  sortOrder    Int      @default(0) @map("sort_order")
  isPublic     Boolean  @default(false) @map("is_public")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  
  news         News?    @relation(fields: [newsId], references: [id], onDelete: SetNull)

  @@map("images")
}

// Online žádost o registraci člena ŠSČR: token → veřejný formulář → PDF → mail předsedovi
model MemberRegistration {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  status      String    @default("pending") // pending | submitted
  note        String?   // pro koho odkaz je (interní poznámka)
  data        Json?     // vyplněná pole žadatele
  pdf         Bytes?    // vygenerovaná žádost (PDF)
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  submittedAt DateTime? @map("submitted_at")

  @@map("member_registrations")
}

// Univerzální ohlášení přestupu: token → hráč vyplní+podepíše → PDF s naším razítkem →
// starý oddíl vytiskne, orazítkuje → sken zpět stejným odkazem → mail předsedovi
model MemberTransfer {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  status      String    @default("pending") // pending | filled | completed
  note        String?
  data        Json?
  pdf         Bytes?    // vygenerované ohlášení (podpis hráče + razítko Bižuterie)
  scan        Bytes?    // sken potvrzený mateřským oddílem
  scanMime    String?   @map("scan_mime")
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  filledAt    DateTime? @map("filled_at")
  completedAt DateTime? @map("completed_at")

  @@map("member_transfers")
}

model Member {
  id        Int     @id @default(autoincrement())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  elo       Int?
  title     String?
  birthYear Int?    @map("birth_year")
  role      String?
  
  @@map("members")
}

model Competition {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("chess-results")
  url       String
  category  String
  chessczUrl String?  @map("chesscz_url")
  sortOrder  Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  
  standings Standing[]
  
  @@map("competitions")
}

model Standing {
  id            Int      @id @default(autoincrement())
  competitionId String   @map("competition_id")
  team          String
  rank          Int
  snr           Int?     // chess-results serial number (different from rank)
  points        Float?
  wins          Int?
  draws         Int?
  losses        Int?
  games         Int?
  score         Float?
  scheduleJson  String?  @map("schedule_json") @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  
  @@unique([competitionId, team])
  @@map("standings")
}

model BlicakRegistration {
  id           Int      @id @default(autoincrement())
  name         String
  club         String?
  lok          String?
  birthYear    Int?     @map("birth_year")
  note         String?
  eventDate    DateTime @default(now()) @map("event_date")
  createdAt    DateTime @default(now()) @map("created_at")
  tournamentId String   @default("vanocni-2025") @map("tournament_id")

  @@map("blicak_registrations")
  @@index([tournamentId])
}


model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model PuzzleRaceResult {
  id           Int      @id @default(autoincrement())
  score        Int
  playerName   String   @map("player_name")
  userId       Int?     @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  mode         String   @default("vanilla") // 'vanilla', 'thematic'
  correctCount Int?     @default(0) @map("correct_count")
  wrongCount   Int?     @default(0) @map("wrong_count")
  maxStreak    Int?     @default(0) @map("max_streak")
  puzzleCount  Int?     @default(0) @map("puzzle_count")

  user         User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([mode, createdAt])
  @@index([userId, mode, createdAt])
  @@map("puzzle_race_results")
}

model GameRecorded {
  id          Int      @id @default(autoincrement())
  white       String
  black       String
  result      String   // "1-0", "0-1", "1/2-1/2", "*"
  date        DateTime @default(now())
  event       String?
  pgn         String   @map("pgn_text")
  uploadedBy  Int?     @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User?    @relation(fields: [uploadedBy], references: [id])

  @@map("games_recorded")
}

model PuzzleRacerSettings {
  id                    Int      @id @default(1)
  puzzleTheme           String   @default("mix") @map("puzzle_theme")
  timeLimitSeconds      Int      @default(180) @map("time_limit_seconds")
  livesEnabled          Boolean  @default(true) @map("lives_enabled")
  maxLives              Int      @default(3) @map("max_lives")
  puzzlesPerDifficulty  Int      @default(6) @map("puzzles_per_difficulty")
  penaltyEnabled        Boolean  @default(false) @map("penalty_enabled")
  penaltySeconds        Int      @default(5) @map("penalty_seconds")
  skipOnMistake         Boolean  @default(false) @map("skip_on_mistake")
  randomizePuzzles      Boolean  @default(true) @map("randomize_puzzles")
  fixedPuzzleSet        Json?    @map("fixed_puzzle_set")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("puzzle_racer_settings")
}

model PuzzleCampSession {
  id              Int      @id @default(autoincrement())
  campCode        String   @default("pardubice-2026") @map("camp_code")
  campName        String   @default("Pardubice 2026") @map("camp_name")
  title           String
  status          String   @default("scheduled")
  startsAt        DateTime @map("starts_at")
  durationSeconds Int      @default(240) @map("duration_seconds")
  puzzleCount     Int      @default(40) @map("puzzle_count")
  puzzleTheme     String   @default("mix") @map("puzzle_theme")
  livesEnabled    Boolean  @default(false) @map("lives_enabled")
  maxLives        Int      @default(5) @map("max_lives")
  penaltyEnabled  Boolean  @default(true) @map("penalty_enabled")
  penaltySeconds  Int      @default(3) @map("penalty_seconds")
  skipOnMistake   Boolean  @default(true) @map("skip_on_mistake")
  puzzles         Json
  createdById     Int      @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy User                @relation("PuzzleCampCreator", fields: [createdById], references: [id])
  attempts  PuzzleCampAttempt[]

  @@index([campCode, startsAt])
  @@index([status, startsAt])
  @@map("puzzle_camp_sessions")
}

model PuzzleCampAttempt {
  id           Int       @id @default(autoincrement())
  sessionId    Int       @map("session_id")
  userId       Int       @map("user_id")
  status       String    @default("waiting")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  score        Int       @default(0)
  correctCount Int       @default(0) @map("correct_count")
  wrongCount   Int       @default(0) @map("wrong_count")
  skippedCount Int       @default(0) @map("skipped_count")
  maxStreak    Int       @default(0) @map("max_streak")
  puzzleCount  Int       @default(0) @map("puzzle_count")
  durationMs   Int       @default(0) @map("duration_ms")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  session       PuzzleCampSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleResults PuzzleCampPuzzleResult[]

  @@unique([sessionId, userId])
  @@index([sessionId, score])
  @@index([userId, joinedAt])
  @@map("puzzle_camp_attempts")
}

model PuzzleCampPuzzleResult {
  id            Int      @id @default(autoincrement())
  attemptId     Int      @map("attempt_id")
  puzzleIndex   Int      @map("puzzle_index")
  puzzleId      String   @map("puzzle_id")
  rating        Int?
  correct       Boolean  @default(false)
  skipped       Boolean  @default(false)
  wrongAttempts Int      @default(0) @map("wrong_attempts")
  wrongMove     String?  @map("wrong_move")
  responseMs    Int      @default(0) @map("response_ms")
  points        Int      @default(0)
  answeredAt    DateTime @default(now()) @map("answered_at")

  attempt PuzzleCampAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, puzzleIndex])
  @@index([attemptId, puzzleIndex])
  @@map("puzzle_camp_puzzle_results")
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  location    String?
  
  // Event categorization
  category    String    @default("tournament") // tournament, training, camp, meeting, other
  ageGroup    String?   @map("age_group")      // youth, adults, all
  eventType   String?   @map("event_type")     // individual, team
  timeControl String?   @map("time_control")   // blitz, rapid, classical
  
  // Tournament-specific fields
  registrationDeadline DateTime? @map("registration_deadline") // přihlášky do
  presentationEnd      DateTime? @map("presentation_end")      // konec prezentace
  entryFee             String?   @map("entry_fee")             // startovné
  organizerContact     String?   @map("organizer_contact")     // kontakt na pořadatele
  url                  String?                                  // odkaz na stránky akce
  
  // Visibility
  isInternal  Boolean   @default(false) @map("is_internal") // true = only MEMBER+
  isPublic    Boolean   @default(true) @map("is_public")
  isFeatured  Boolean   @default(false) @map("is_featured") // Shown in featured banner
  
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  @@map("events")
}

// ==========================================
// Timeline (milníky klubu v about.html)
// ==========================================
model TimelineEntry {
  id          Int      @id @default(autoincrement())
  year        Int
  yearLabel   String?  @map("year_label")
  event       String
  description String?  @db.Text
  category    String?
  icon        String   @default("fa-chess-pawn") // FontAwesome třída, např. fa-chess-rook
  imageUrl    String?  @map("image_url")
  imageAlt    String?  @map("image_alt")
  sortOrder   Int      @default(0) @map("sort_order")
  isFuture    Boolean  @default(false) @map("is_future") // cíl, ne historie
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("timeline_entries")
}

// ==========================================
// Chess Database (SSCR 2003-2025)
// ==========================================

model ChessGame {
  id          Int       @id @default(autoincrement())
  event       String?
  site        String?
  date        DateTime?
  round       String?
  whitePlayer String    @map("white_player")
  blackPlayer String    @map("black_player")
  result      String    // "1-0", "0-1", "1/2-1/2", "*"
  eco         String?
  whiteElo    Int?      @map("white_elo")
  blackElo    Int?      @map("black_elo")
  plyCount    Int?      @map("ply_count")
  moves       String    @db.Text // SAN moves as string
  
  @@index([whitePlayer])
  @@index([blackPlayer])
  @@index([eco])
  blunderAnalyses BlunderAnalysis[]

  @@index([date])
  @@map("chess_games")
}

model ChessMove {
  id       Int    @id @default(autoincrement())
  gameId   Int    @map("game_id")
  plyNum   Int    @map("ply_num")  // 1 = first white move, 2 = first black, etc.
  san      String // "e4", "Nf3", etc.
  
  @@index([san, plyNum])
  @@index([gameId])
  @@map("chess_moves")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int      @map("author_id")
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  
  author    User     @relation(fields: [authorId], references: [id])
  
  @@map("announcements")
}

model Document {
  id           Int      @id @default(autoincrement())
  title        String
  filename     String
  url          String
  category     String   @default("other") // stanovy, zapisy, formulare, other
  visibility   String   @default("members") // members, admin
  uploadedById Int      @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  @@map("documents")
}

model TravelReport {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  date         DateTime
  from         String
  to           String
  purpose      String
  distance     Int
  vehicle      String   // car, bus, other
  licensePlate String?  @map("license_plate") // SPZ vozidla
  passengers   String?  // Spolucestující (čárkou oddělená jména)
  status       String   @default("pending") // pending, approved, rejected
  note         String?  // Admin note for approval/rejection
  createdAt    DateTime @default(now()) @map("created_at")
  
  user         User     @relation(fields: [userId], references: [id])
  
  @@map("travel_reports")
}

// Discussion Forum
model ForumTopic {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  authorId    Int      @map("author_id")
  isPinned    Boolean  @default(false) @map("is_pinned")
  isLocked    Boolean  @default(false) @map("is_locked")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  author      User        @relation(fields: [authorId], references: [id])
  posts       ForumPost[]
  
  @@map("forum_topics")
}

model ForumPost {
  id        Int      @id @default(autoincrement())
  content   String
  topicId   Int      @map("topic_id")
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id])

  @@index([topicId])
  @@map("forum_posts")
}

model Diagram {
  id          Int      @id @default(autoincrement())
  fen         String
  annotations Json     // Stores arrows, squares as JSON object
  solution    Json?    // Interactive solver data (correct moves, comments)
  name        String?
  description String?
  userId      Int?     @map("user_id") // Optional link to creator
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User?    @relation(fields: [userId], references: [id])
  
  @@map("diagrams")
}

model Fragment {
  id           Int      @id @default(autoincrement())
  title        String
  pgn          String   @db.Text
  startFen     String   @map("start_fen")
  fromMove     Int      @map("from_move")
  toMove       Int      @map("to_move")
  sourceGameId Int?     @map("source_game_id")
  white        String?
  black        String?
  userId       Int?     @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id])

  @@map("fragments")
}

model BlunderAnalysis {
  id            Int      @id @default(autoincrement())
  playerName    String   @map("player_name")
  gameId        Int      @map("game_id")
  type          String   // "blunder" | "miss"
  fenBefore     String   @map("fen_before")
  movePlayed    String   @map("move_played")
  movePlayedLAN String   @map("move_played_lan")
  bestMoveLAN   String?  @map("best_move_lan")
  evalBefore    Float?   @map("eval_before")
  evalAfter     Float?   @map("eval_after")
  probDrop      Float    @map("prob_drop")
  white         String
  black         String
  result        String?
  isFeatured    Boolean  @default(false) @map("is_featured")
  createdAt     DateTime @default(now()) @map("created_at")

  game          ChessGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([playerName])
  @@index([gameId])
  @@map("blunder_analyses")
}

model BlunderScanLog {
  id           Int      @id @default(autoincrement())
  playerName   String   @map("player_name")
  gamesScanned Int      @map("games_scanned")
  totalGames   Int      @map("total_games")
  lastGameId   Int?     @map("last_game_id")
  scannedAt    DateTime @default(now()) @map("scanned_at")

  @@index([playerName])
  @@map("blunder_scan_logs")
}

/// Sledovaní hráči pro scraping chess-results.com — lidé, které chceme mít
/// ve výsledcích i když nejsou registrovaní za náš klub (např. trenéři).
// Soustředění Pardubice: mapa našich hráčů na startovní čísla v chess-results
model CampPlayer {
  id             Int     @id @default(autoincrement())
  campCode       String  @map("camp_code")
  tnr            String
  tournamentCode String  @map("tournament_code")
  startNo        Int     @map("start_no")
  displayName    String  @map("display_name")
  birthYear      Int?    @map("birth_year")
  role           String? // 'trener' apod.
  active         Boolean @default(true)
  sortOrder      Int     @default(0) @map("sort_order")

  @@unique([campCode, tnr, startNo])
  @@index([campCode, active])
  @@map("camp_players")
}

// Odběratelé upozornění na nový los (web push — bez e-mailu a telefonu)
model PushSubscriber {
  id        Int      @id @default(autoincrement())
  campCode  String   @map("camp_code")
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  failCount Int      @default(0) @map("fail_count")

  @@index([campCode])
  @@map("push_subscribers")
}

// Cache poslední stažené podoby dashboardu (web nikdy nesahá na chess-results přímo)
model CampSnapshot {
  id           String   @id
  payloadJson  String   @map("payload_json")
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@map("camp_snapshots")
}

model TrackedPlayer {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")   // "Příjmení, Jméno" — formát chess-results
  sscrId    String?  @map("sscr_id")     // Ident-číslo ŠSČR z karty hráče (nejspolehlivější identifikátor)
  club      String?                      // za koho je registrovaný (proč je ve watchlistu)
  note      String?
  active    Boolean  @default(true)
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([active])
  @@map("tracked_players")
}
