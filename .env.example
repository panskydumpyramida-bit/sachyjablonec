# Vzor konfigurace. Zkopíruj na .env a vyplň.
# POZOR: repo je VEŘEJNÉ — do tohohle souboru nikdy nepiš skutečné hodnoty.

# --- základ ---
DATABASE_URL=
PORT=3001
NODE_ENV=development
FRONTEND_URL=
ALLOWED_ORIGINS=

# --- přihlašování ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_PASSWORD=
CLUB_PASSWORD=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- e-mail (Resend) ---
RESEND_API_KEY=
REGISTRATION_EMAIL=

# --- Facebook / Instagram ---
FB_APP_ID=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=
IG_USER_ID=

# --- ostatní ---
OPENAI_API_KEY=
STOCKFISH_PATH=
SSCR_CLUB_CODE=
MAINTENANCE_MODE=false

# --- upozornění na nový los: web push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@sachyjablonec.cz

# --- upozornění na nový los: WhatsApp ---
# Zpráva jde jednomu člověku, ten ji přepošle do skupiny (WhatsApp API
# neumí psát do skupin). Když tohle není vyplněné, web funguje normálně,
# jen se WhatsApp neposílá — web push jede nezávisle.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=callmebot
# telefon příjemce v mezinárodním tvaru, např. +420XXXXXXXXX
CALLMEBOT_PHONE=
# klíč, který příjemci pošle bot po aktivační zprávě (viz DEPLOYMENT.md)
CALLMEBOT_APIKEY=
# pojistka proti zahlcení příjemce
WHATSAPP_MAX_PER_DAY=12
